# Copy this file to .env and fill in real values. Never commit .env.
# These are exposed to the browser (Vite bundles anything prefixed VITE_),
# so only ever put PUBLIC/anon-safe values here — never a service role key
# or the Anthropic API key.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
